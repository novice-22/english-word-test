# 의존성
node_modules/

# 빌드 결과물
client/dist/

# 데이터베이스 (로컬/서버 데이터)
server/data/
data/

# 인증 설정 (비밀번호 해시·구글 시크릿) — 절대 커밋 금지
auth.json
**/auth.json

# 개인 문서 (서버 구성·점검 기록 등) — 공개하지 않는다
_private/

# 교재 원본 (PDF 스캔본·엑셀·CSV) — 저작권이 있어 공개하지 않는다.
# README 가 "단어 데이터는 들어있지 않습니다" 라고 공언하는 근거다.
word/

# 개인 작업 메모 — 공개하지 않는다
영단어 저작권 가능한지.txt

# 품사 검증 사전 — 저작권 있는 교재에서 파생된 데이터라 공개하지 않는다.
# 없어도 앱은 어미 규칙만으로 동작한다 (server/pos-lexicon.example.js 참고).
server/pos-lexicon.js

# CMUdict 원본(약 3.6MB) — 산출물 server/phonetics.json.gz 만 커밋한다.
# 다시 만들 때 받으면 된다: tools/build-phonetics.mjs 주석 참고.
tools/cmudict.dict

# 환경 변수
.env
.env.*

# 로그
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db
